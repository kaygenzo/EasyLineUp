<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" android:host="*"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" android:host="*"/>
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Not for new photos (the photo picker needs no permission), but for old ones: before it,
         the app asked for this permission and stored MediaStore URIs, which stay readable on
         Android 12 and below only with it. Removing it would revoke it for existing users and
         blank their older player and team photos. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove"/>

    <application
        android:name=".application.App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:replace="android:icon,android:allowBackup">
        <!-- adjustPan, not adjustResize: forms pin a header and a save bar around their scrolling
             fields, and on a landscape phone resizing above the keyboard leaves those fields no
             height at all (checked at 360x640dp). Panning slides the window so the focused field
             stays visible. -->
        <activity
            android:name=".HomeActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustPan"
            android:exported="false"/>
        <activity
            android:name=".splashscreen.SplashScreenActivity"
            android:theme="@style/Theme.App.Starting"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Opening an .elu file from another app. Only content:// URIs: a file:// one
                 throws FileUriExposedException in any sender targeting API 24+, and reading it
                 would need storage permission. Not BROWSABLE: a web link is never an .elu file
                 the app can read, and a binary download should not offer to open with it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:pathPattern=".*\\.elu"
                    android:host="*" />
            </intent-filter>
            <!-- .elu is no registered type, so mail and messaging apps hand an attachment over as
                 application/octet-stream behind an opaque URI with no file name in its path:
                 this is the only filter that catches it. A file that turns out not to be an
                 .elu export is refused when read, with the import's error message. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:mimeType="application/octet-stream"
                    android:host="*" />
            </intent-filter>
        </activity>
        <activity android:name=".team.createTeam.TeamCreationActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustPan"
            android:exported="false"/>

        <activity android:name=".login.LoginActivity"
            android:theme="@style/AppTheme.NoActionBar.FullScreen"
            android:exported="false"/>

        <activity
            android:name=".splashscreen.ImportDataActivity"
            android:theme="@style/AppTheme.NoActionBar.FullScreen"
            android:exported="false"/>
        
        <provider
            android:authorities="@string/file_provider_authority"
            android:name=".utils.LineupFileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths"/>
        </provider>

        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
    </application>

</manifest>
