<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/spacing_xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md">

        <!-- TEAM -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_category_team" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsCard">

            <LinearLayout
                android:id="@+id/rowTeam"
                style="@style/SettingsRow"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    style="@style/SettingsRowTextContainer">

                    <TextView
                        android:id="@+id/rowTeamTitle"
                        style="@style/SettingsRowTitle"
                        tools:text="Riverside Hawks" />

                    <TextView
                        style="@style/SettingsRowSubtitle"
                        android:text="@string/settings_team_row_subtitle" />
                </LinearLayout>

                <ImageView
                    style="@style/SettingsRowChevron"
                    android:contentDescription="@string/settings_category_team" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- STYLE -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_category_style" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowLineupStyle"
                    style="@style/SettingsRow"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout style="@style/SettingsRowTextContainer">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/setting_lineup_style_description" />

                        <TextView
                            android:id="@+id/rowLineupStyleValue"
                            style="@style/SettingsRowSubtitle" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowMenColor"
                    style="@style/SettingsRow"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout style="@style/SettingsRowTextContainer">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/setting_men_style_description" />
                    </LinearLayout>

                    <View
                        android:id="@+id/rowMenColorSwatch"
                        style="@style/SettingsRowColorSwatch" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowWomenColor"
                    style="@style/SettingsRow"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout style="@style/SettingsRowTextContainer">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/setting_women_style_description" />
                    </LinearLayout>

                    <View
                        android:id="@+id/rowWomenColorSwatch"
                        style="@style/SettingsRowColorSwatch" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowDayNight"
                    style="@style/SettingsRow"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout style="@style/SettingsRowTextContainer">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/setting_day_night_style_description" />

                        <TextView
                            android:id="@+id/rowDayNightValue"
                            style="@style/SettingsRowSubtitle" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DATA -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/settings_category_data" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowExport"
                    style="@style/SettingsRow"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout style="@style/SettingsRowTextContainer">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/setting_export_data_description" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowImport"
                    style="@style/SettingsRow"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout style="@style/SettingsRowTextContainer">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/setting_import_data_description" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowTextContainer">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/setting_import_data_update_object_description" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchUpdateExisting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowDelete"
                    style="@style/SettingsRow"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout style="@style/SettingsRowTextContainer">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:textColor="?attr/colorError"
                            android:text="@string/setting_delete_data_description" />
                    </LinearLayout>

                    <ImageView
                        style="@style/SettingsRowChevron"
                        app:tint="?attr/colorError" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ABOUT -->
        <TextView
            style="@style/SettingsSectionLabel"
            android:text="@string/setting_category_about_title" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/SettingsRow">

                    <LinearLayout style="@style/SettingsRowTextContainer">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/setting_version_title" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/rowVersionValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Dugout.Tabular"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowLicenses"
                    style="@style/SettingsRow"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout style="@style/SettingsRowTextContainer">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/setting_licenses_title" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/rowPlayStore"
                    style="@style/SettingsRow"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout style="@style/SettingsRowTextContainer">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/setting_play_store_title" />
                    </LinearLayout>

                    <ImageView style="@style/SettingsRowChevron" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
